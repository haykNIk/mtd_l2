# ---------------------------------------------------------------------------
# ЛР4, п. 4.2: веб-сервер nginx в Docker (аналог Dockerfile из видео курса).
#
# ВАЖНО: без поля MAINTAINER — оно устарело (deprecated), задание прямо
# просит его не писать.
#
# Сборка: docker build -t my_nginx_image .
# Запуск: docker run -d -p 9000:80 my_nginx_image
# Браузер: http://localhost:9000
#
# @Author: hayknik
# ---------------------------------------------------------------------------

FROM nginx:latest

# Кладём свою статическую страницу вместо стандартной
COPY ./index.html /usr/share/nginx/html/index.html

# EXPOSE — только ДЕКЛАРАЦИЯ: документирует, что сервис слушает 80,
# но НЕ открывает порт. Порт открывается флагом -p при docker run.
EXPOSE 80
